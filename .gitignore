# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Keep the analytics env template tracked
!.env.example

# Local analytics screenshots (Cloudflare/GA captures) - keep out of the public repo
*_traffic_*.PNG
traffic_*.PNG

# Handbook PDFs and quote extraction caches - large, regenerable from the
# official sites, and only needed while building a jurisdiction bank.
tmp/

# Raw result-art source images and preview thumbnails - shipped copies live in public/results/
/images/

# Wrangler local state (dev KV emulation, build cache)
.wrangler/
