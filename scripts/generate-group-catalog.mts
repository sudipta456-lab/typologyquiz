import { readFileSync, writeFileSync } from "node:fs";
import { getRunSize, TRIVIA_QUIZZES } from "../src/lib/trivia/registry";

// The Worker cannot import the TypeScript trivia registry at runtime. This
// generated snapshot makes room creation authoritative without copying quiz
// data or answer keys into the Worker bundle.
const catalog = Object.fromEntries(
  TRIVIA_QUIZZES.map((quiz) => [quiz.slug, { title: quiz.title, total: getRunSize(quiz) }])
);
const output = `// Generated by scripts/generate-group-catalog.mts. Registry metadata only.\nexport const GROUP_TRIVIA_CATALOG = Object.freeze(${JSON.stringify(catalog)});\n`;
const destination = "worker/group-catalog.js";
if (process.argv.includes("--check")) {
  if (readFileSync(destination, "utf8") !== output) throw new Error("Group trivia catalog is stale; run npm run generate:group-catalog");
} else {
  writeFileSync(destination, output);
}
console.log(`Group trivia catalog ${process.argv.includes("--check") ? "checked" : "generated"}: ${TRIVIA_QUIZZES.length} quizzes`);
